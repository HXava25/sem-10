{
  "info": {
    "name": "Semana 10 - API de productos",
    "description": "Pruebas CRUD de la API REST de productos. La colección cubre los 4 verbos HTTP (GET, POST, PUT, DELETE) y valida códigos de estado, headers y cuerpo de respuesta. Ejecutar en orden; el POST guarda el id para las solicitudes siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "GET - Listar productos",
      "request": {
        "description": "Obtiene todos los productos almacenados en la base de datos. Retorna un arreglo JSON con todos los registros de la tabla products ordenados por id. Si no hay productos registrados, devuelve un arreglo vacío.",
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 y JSON', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.response.to.be.json;",
              "});",
              "pm.test('Content-Type es application/json', function () {",
              "  pm.response.to.have.header('Content-Type');",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('El resultado es una lista', function () {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Crear producto",
      "request": {
        "description": "Crea un nuevo producto en la base de datos. Requiere Content-Type application/json y un cuerpo con los campos name (obligatorio), price (obligatorio, >= 0), description (opcional) y stock (opcional, default 0). Retorna el producto creado con su id y timestamps.",
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Producto de prueba\",\n  \"description\": \"Creado desde Postman\",\n  \"price\": 19.99,\n  \"stock\": 5\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201 y JSON', function () {",
              "  pm.response.to.have.status(201);",
              "  pm.response.to.be.json;",
              "});",
              "pm.test('Content-Type es application/json', function () {",
              "  pm.response.to.have.header('Content-Type');",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Devuelve un producto con el esquema esperado', function () {",
              "  const product = pm.response.json();",
              "  pm.expect(product).to.have.property('id').that.is.a('number');",
              "  pm.expect(product).to.have.property('name', 'Producto de prueba');",
              "  pm.expect(product).to.have.property('price').that.is.a('number');",
              "  pm.expect(product).to.have.property('stock', 5);",
              "  pm.expect(product).to.have.property('created_at');",
              "});",
              "pm.collectionVariables.set('productId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Consultar producto por ID",
      "request": {
        "description": "Consulta un producto específico por su identificador. Utiliza el id guardado automáticamente del POST anterior. Retorna el objeto del producto con todos sus campos si existe, o un error 404 si no se encuentra.",
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 y JSON', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.response.to.be.json;",
              "});",
              "pm.test('Content-Type es application/json', function () {",
              "  pm.response.to.have.header('Content-Type');",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Devuelve el producto creado', function () {",
              "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('productId')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT - Actualizar producto",
      "request": {
        "description": "Actualiza todos los campos editables de un producto existente. Requiere Content-Type application/json y el mismo cuerpo que POST (name y price obligatorios). Los campos omitidos se restablecen a sus valores por defecto (description a null, stock a 0).",
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Producto actualizado\",\n  \"description\": \"Actualizado desde Postman\",\n  \"price\": 24.5,\n  \"stock\": 8\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 y JSON', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.response.to.be.json;",
              "});",
              "pm.test('Content-Type es application/json', function () {",
              "  pm.response.to.have.header('Content-Type');",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Devuelve los datos actualizados', function () {",
              "  pm.expect(pm.response.json().name).to.eql('Producto actualizado');",
              "  pm.expect(pm.response.json().stock).to.eql(8);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - Eliminar producto",
      "request": {
        "description": "Elimina físicamente un producto de la base de datos por su id. Retorna un mensaje de confirmación si el producto existía, o un error 404 si no se encontró el registro.",
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 y confirma la eliminación', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.response.to.be.json;",
              "  pm.expect(pm.response.json()).to.have.property('message');",
              "});",
              "pm.test('Content-Type es application/json', function () {",
              "  pm.response.to.have.header('Content-Type');",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
